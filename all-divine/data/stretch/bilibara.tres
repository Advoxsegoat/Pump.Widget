[gd_resource type="Resource" script_class="StretchDef" load_steps=6 format=3]

[ext_resource type="Script" path="res://world/stretch/stretch_def.gd" id="1_def"]
[ext_resource type="Script" path="res://world/stretch/shrine_def.gd" id="2_shrine"]
[ext_resource type="Resource" path="res://data/stretch/rose_a.tres" id="3_a"]
[ext_resource type="Resource" path="res://data/stretch/rose_b.tres" id="4_b"]
[ext_resource type="Script" path="res://world/stretch/gate_def.gd" id="5_gate"]
[ext_resource type="Resource" path="res://data/stretch/gate_shortcut.tres" id="6_gs"]

[resource]
script = ExtResource("1_def")
id = &"bilibara"
region = "res://world/bilibara/bilibara.tscn"
shrines = Array[ExtResource("2_shrine")]([ExtResource("3_a"), ExtResource("4_b")])
start_shrine = &"rose_a"
; The toll board (gate_toll) is not placed yet: the owner has not said where the mini-boss stands. To place it, add to this array
; ExtResource("7_gt") after declaring [ext_resource type="Resource" path="res://data/stretch/gate_toll.tres" id="7_gt"].
gates = Array[ExtResource("5_gate")]([ExtResource("6_gs")])
